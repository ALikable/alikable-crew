# Caddy reverse proxy for Alikable. setup.sh copies this to /etc/caddy/Caddyfile.
# Plain HTTP on port 80 (open it in the security group). For HTTPS later, replace :80 with
# a domain whose DNS points at the instance, and Caddy gets the certificate itself.
#
# reverse_proxy passes WebSockets through and flushes Server-Sent Events, which Gradio's
# queue and live panels need. The app itself listens on 127.0.0.1:7860 only.

:80 {
	encode gzip
	reverse_proxy 127.0.0.1:7860
}
