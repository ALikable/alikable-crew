# Copy to /opt/alikable-crew/alikable/.env on the server (setup.sh does it if .env is missing),
# fill in the values, keep it chmod 600. Never commit it.

# MODEL: same value as your local .env
MODEL=
OPENAI_API_KEY=
CREWAI_TRACING_ENABLED=true

# Where the app listens. Keep 127.0.0.1: Caddy is the only thing that should reach it.
ALIKABLE_HOST=127.0.0.1
ALIKABLE_PORT=7860

# Login for the whole app, served pages included. Leave either empty and there is no login,
# so anyone with the URL can run crews on your OpenAI key.
ALIKABLE_USER=
ALIKABLE_PASSWORD=
